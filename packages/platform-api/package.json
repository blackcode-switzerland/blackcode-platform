{
  "name": "@blackcode/platform-api",
  "version": "0.0.0",
  "description": "App-agnostic HTTP plumbing: the error envelope, the list envelope, log sanitisation, platform-wide limits, the shared request layer and the platform route factories.",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./routes": "./src/routes/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test --ext .ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@blackcode/platform-agent": "*",
    "@blackcode/platform-auth": "*",
    "@blackcode/platform-db": "*",
    "@blackcode/platform-i18n": "*",
    "@blackcode/platform-storage": "*",
    "@vercel/blob": "^0.23.4",
    "drizzle-orm": "^0.45.2",
    "next": "^16.1.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "typescript": "^5.6.2",
    "vitest": "^4.1.8"
  }
}
