# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
#
# MONOREPO NOTE: patterns here must NOT be anchored with a leading slash unless
# they genuinely only apply to the repo root. A leading slash matches only the
# root, so `/node_modules` silently stopped covering `apps/issues/node_modules`
# when the app moved down a level. Unanchored patterns match at every depth,
# which is what a workspace layout needs.

gitIgnore
.playwright-mcp
scratchpad

# turborepo
.turbo

# dependencies
node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage

# next.js
.next/
out/

# production
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# locally-uploaded files (used when BLOB_READ_WRITE_TOKEN is unset in dev).
# `**/` is required: a pattern containing a slash is anchored to this file's
# directory, so plain `public/uploads/` would only match at the repo root.
**/public/uploads/

# typescript
*.tsbuildinfo
next-env.d.ts

# Sales-app implementation scratch — master/agent handoff files. Temporary.
/salesImplementation/

# transient, deploy-day working files
/RUN-NOW.txt
/.google-new
/multiAppFinalRefactor/.prod-url
