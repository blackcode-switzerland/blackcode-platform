{
  "name": "@blackcode/platform-i18n",
  "version": "0.0.0",
  "description": "The interface-language mechanism: the vocabulary, the resolution order, the typed dictionary lookup, and the server and client readers. Each app supplies its own strings.",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./locale": "./src/locale.ts",
    "./dictionary": "./src/dictionary.ts",
    "./server": "./src/server.ts",
    "./client": "./src/client.tsx"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "devDependencies": {
    "typescript": "^5.6.2",
    "@typescript-eslint/parser": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "eslint": "^8.57.0"
  }
}
