{
  "name": "@blackcode/platform-agent",
  "version": "0.0.0",
  "description": "The agent surface every app shares: the merged changelog feed and the advertised CLI versions (read live from npm).",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./changelog": "./src/changelog.ts",
    "./cli-version": "./src/cli-version.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run"
  },
  "dependencies": {
    "marked": "^18.0.5",
    "sanitize-html": "^2.17.5"
  },
  "devDependencies": {
    "@types/sanitize-html": "^2.16.1",
    "typescript": "^5.6.2",
    "@typescript-eslint/parser": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "eslint": "^8.57.0",
    "vitest": "^4.1.8"
  }
}
